APP_NAME="গভর্নমেন্ট ল্যাবরেটরি হাই স্কুল"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Dhaka

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=govlab_school
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
FILESYSTEM_DISK=local

QUEUE_CONNECTION=sync

MAIL_MAILER=log
MAIL_FROM_ADDRESS="govlabcomilla@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"
